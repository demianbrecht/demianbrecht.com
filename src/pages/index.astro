---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import { isCurrent } from '../utils';
import { buildTimeline, seriesMetadata } from '../timeline';

const posts = await getCollection('posts', isCurrent);
const series = (await getCollection('series')).map(seriesMetadata);
const timeline = buildTimeline(posts, series);
---

<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <h1>{SITE_TITLE}</h1>
      <p class="tagline">{SITE_TAGLINE}</p>
    </section>

    {timeline.length === 0 ? (
      <p class="empty-state">No posts yet.</p>
    ) : (
      <ul class="post-list">
        {timeline.map((item) => (
          <li>
            {item.type === 'post'
              ? <PostCard post={item.post} />
              : <SeriesCard series={item.series} members={item.members} />}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
